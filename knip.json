{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "next": {
    "entry": [
      "src/app/**/{page,layout,loading,error,not-found,route}.{js,jsx,ts,tsx}",
      "src/middleware.ts"
    ]
  },
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route}.{js,jsx,ts,tsx}",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.check.ts",
    "src/**/*.test.{ts,tsx}",

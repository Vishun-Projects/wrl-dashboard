    "src/lib/read-model/debug-trn-status.ts",
    "src/lib/read-model/repair-trn-from-crm.ts",
    "src/lib/read-model/repair-and-check-trn.ts",
    "src/modules/mis/services/call-register/verify-*.ts"
  ],

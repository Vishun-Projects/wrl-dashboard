// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CallComment {
  id          Int      @id @default(autoincrement())
  call_id     String
  content     String
  created_at  DateTime @default(now())
  author_id   String?
  author_name String?

  @@map("call_comments")
}

model AppUser {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  role       String   // "branch_manager", "hod"
  office_ids String[] @default([]) // Array of ncode values from CRM mstoffice
  avatar_url String?
  created_at DateTime @default(now())

  @@map("app_users")
}

model SyncStatus {
  id           Int      @id @default(1)
  is_running   Boolean  @default(false)
  progress     Int      @default(0)
  current_step String?
  total_chunks Int      @default(0)
  done_chunks  Int      @default(0)
  abort_requested Boolean  @default(false)
  last_updated DateTime @default(now())

  @@map("sync_status")
}

model CachedVisit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  call_id          String
  office_id        String
  person_contacted String?
  visit_date       DateTime?
  remark           String?
  duration         Int?
  expense          Decimal? @db.Decimal
  created_at       DateTime @default(now())

  @@index([call_id, office_id], name: "idx_cached_visits_call")
  @@map("cached_visits")
}

model CachedPart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  call_id    String
  office_id  String
  part_name  String?
  part_code  String?
  quantity   Int?
  created_at DateTime @default(now())

  @@index([call_id, office_id], name: "idx_cached_parts_call")
  @@map("cached_parts")
}

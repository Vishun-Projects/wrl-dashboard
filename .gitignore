# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.docx
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# local server corpus cache (large date-window snapshots)
.cache/

# scheduled sync logs
/logs/

# local dump of non-runtime archives / one-off scripts (see dump/README.md)
/dump/

next-env.d.ts

/src/generated/prisma

.vercel
eslint-report.json
eslint-unused.json
eslint-any.json
eslint-hooks.json

# local scratch / generated artifacts (never commit)
/scratch/
/artifacts/
=

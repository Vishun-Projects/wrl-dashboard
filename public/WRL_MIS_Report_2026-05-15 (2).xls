
        
      <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
      <head><meta charset="UTF-8"><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Report</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
      <style>
        table { border-collapse: collapse; font-family: sans-serif; font-size: 11px; }
        th { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 5px; text-transform: uppercase; }
        td { border: 1px solid #e2e8f0; padding: 4px; }
        .north { background-color: #c6e0b4; }
        .east { background-color: #bdd7ee; }
        .west { background-color: #f8cbad; }
        .south { background-color: #d9d9d9; }
        .total { background-color: #ffff00; font-weight: bold; }
        .header-main { background-color: #0070c0; color: white; font-weight: bold; }
        .solved { color: #059669; }
        .cancelled { color: #dc2626; }
        .open { font-weight: bold; background-color: #f8fafc; }
      </style>
